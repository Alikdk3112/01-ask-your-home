# Kopieren nach .env und ausfüllen:  cp .env.example .env
#
# OpenRouter API-Key (https://openrouter.ai/keys).
# Wird NUR serverseitig in der Vite-Middleware genutzt und landet NIE im Client-Bundle.
OPENROUTER_API_KEY=sk-or-...

# Optional – Modell überschreiben (Default: openai/gpt-4o-mini)
# Alternativen: google/gemini-2.5-flash-lite | anthropic/claude-haiku-4-5
OPENROUTER_MODEL=openai/gpt-4o-mini
